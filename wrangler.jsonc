{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "andrenaagency",
  "main": "site-worker.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ]
}
